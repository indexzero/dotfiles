#!/usr/bin/env zsh
#
# vm - the tart commands build/tart/README.md repeats, with the names fixed.
#
# Usage:
#   vm tags [image]           list vanilla image tags (default: macos-tahoe-vanilla)
#   vm pristine <image>       pull <image> as "pristine" and grow its disk
#   vm new <name>             clone pristine -> <name>
#   vm run <name>             boot <name> with the dotfiles checkout shared read-only
#   vm ssh <name> [cmd...]    ssh $TART_USER@<name> (default admin, password: admin)
#   vm scp <name> <from> [to] copy a file out of the guest as $TART_USER.
#                             <from> is a guest path (~ allowed); [to] defaults
#                             to the current directory. For a file into the
#                             guest, swap: vm scp <name> --to <local> <guest>
#   vm grow <name>            boot <name> into Recovery to grow its APFS container
#                             to the full disk. Do this once, on pristine; every
#                             clone then starts with the big volume. Prints the
#                             three diskutil commands to run in Recovery's Terminal.
#   vm adduser <name> [user]  create an admin account in the guest (default cjr,
#                             password: admin). home.nix hardcodes cjr, so the
#                             nix step needs this; then TART_USER=cjr vm ssh ...
#   vm reset <name>           delete <name> and clone it again from pristine
#   vm rm <name>              delete <name>
#
# Env: TART_PRISTINE (pristine), TART_CPU (6), TART_MEMORY (16384),
#      TART_DISK (120), TART_USER (admin), DOTFILES_HOME (~/Git/indexzero/dotfiles)

set -euo pipefail

PRISTINE="${TART_PRISTINE:-pristine}"
CPU="${TART_CPU:-6}"
MEMORY="${TART_MEMORY:-16384}"
DISK="${TART_DISK:-120}"
USER_="${TART_USER:-admin}"
DOTFILES_HOME="${DOTFILES_HOME:-$HOME/Git/indexzero/dotfiles}"
SELF="${0:A}"   # $0 inside a zsh function is the function name, so capture the script path here

die() { print -u2 -r -- "vm: $*"; exit 1; }
need() { [[ -n "${1:-}" ]] || die "missing VM name"; }

cmd_tags() {
  local image="${1:-macos-tahoe-vanilla}" tok
  tok="$(curl -fsSL "https://ghcr.io/token?scope=repository:cirruslabs/$image:pull" \
    | python3 -I -c 'import sys,json;print(json.load(sys.stdin)["token"])')"
  curl -fsSL -H "Authorization: Bearer $tok" "https://ghcr.io/v2/cirruslabs/$image/tags/list" \
    | python3 -I -c 'import sys,json;print("\n".join(sorted(json.load(sys.stdin)["tags"])))'
}

cmd_pristine() {
  local image="${1:-}"
  [[ -n "$image" ]] || die "usage: vm pristine <image>  (see: vm tags)"
  tart list --quiet 2>/dev/null | grep -qx "$PRISTINE" && die "$PRISTINE exists; 'tart delete $PRISTINE' first"
  tart clone "$image" "$PRISTINE"
  # Grow before the first boot: the guest expands its container on boot.
  tart set "$PRISTINE" --cpu "$CPU" --memory "$MEMORY" --disk-size "$DISK"
  tart get "$PRISTINE"
}

cmd_new() {
  need "${1:-}"
  tart clone "$PRISTINE" "$1"
}

cmd_run() {
  need "${1:-}"
  # Resolve the share first: VZ reports a missing path only as
  # "A directory sharing device configuration is invalid".
  local share="${~DOTFILES_HOME}"   # expand a literal ~
  share="${share:A}"                # absolute, symlinks resolved
  [[ -d "$share" ]] || die "DOTFILES_HOME='$DOTFILES_HOME' is not a directory (resolved: $share)"
  print -r -- "sharing $share -> /Volumes/My Shared Files/dotfiles (ro)"
  # The window stays open on purpose: cask and CLT dialogs land there.
  tart run "$1" --dir="dotfiles:${share}:ro"
}

cmd_ssh() {
  need "${1:-}"
  local name="$1"; shift
  local ip
  ip="$(tart ip "$name")" || die "no IP yet for $name; is it running?"
  # Every clone gets a new MAC and IP; don't let known_hosts pile up.
  ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "${USER_}@${ip}" "$@"
}

# tart set --disk-size grows the raw image only. Inside the guest the layout
# is: 0.5 GB iSCPreboot, the ~44 GB system container, a 5 GB recovery
# container, then all the new space. APFS cannot grow a container across the
# recovery partition, and the system container cannot be touched while it is
# booted (resizeContainer returns -69519). tart's documented fix is to do it
# from Recovery, once. Run on pristine; clones inherit the result.
cmd_grow() {
  need "${1:-}"
  cat <<'STEPS'
Booting into Recovery. In the window: Utilities > Terminal, then:

  diskutil list physical
      # note the identifiers: the Apple_APFS "Container" partition (usually
      # disk0s2) and the Apple_APFS_Recovery partition after it (disk0s3)
  diskutil eraseVolume free free disk0s3
  yes | diskutil repairDisk disk0
  diskutil apfs resizeContainer disk0s2 0
  diskutil list physical
      # the container now spans the disk; then Apple menu > Shut Down

Back here: `vm new <clone>` from this VM and `df -h /` inside shows ~120 GB.
STEPS
  tart run "$1" --recovery
}

# The vanilla image has one account, admin/admin. home.nix pins
# home.username = "cjr" and /Users/cjr, so the nix step only activates for a
# user of that name. Create it once per VM, then run the bootstrap as it.
cmd_scp() {
  need "${1:-}"
  local name="$1"; shift
  local ip
  ip="$(tart ip "$name")" || die "no IP yet for $name; is it running?"
  local opts=(-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null)
  if [[ "${1:-}" == --to ]]; then
    shift; [[ -n "${1:-}" && -n "${2:-}" ]] || die "usage: vm scp <name> --to <local> <guest>"
    scp "${opts[@]}" "$1" "${USER_}@${ip}:$2"
  else
    [[ -n "${1:-}" ]] || die "usage: vm scp <name> <guest-path> [local-path]"
    scp "${opts[@]}" "${USER_}@${ip}:$1" "${2:-.}"
  fi
}

cmd_adduser() {
  need "${1:-}"
  local name="$1" user="${2:-cjr}" saved="$USER_"
  USER_=admin
  cmd_ssh "$name" \
    "sudo sysadminctl -addUser '$user' -fullName '$user' -shell /bin/zsh -password admin -admin && \
     sudo dseditgroup -o edit -a '$user' -t user com.apple.access_ssh 2>/dev/null; \
     id '$user'"
  USER_="$saved"
  print -r -- "created $user (password: admin). Next: TART_USER=$user $SELF ssh $name"
}

cmd_reset() {
  need "${1:-}"
  tart delete "$1" 2>/dev/null || true
  tart clone "$PRISTINE" "$1"
}

cmd_rm() {
  need "${1:-}"
  tart delete "$1"
}

case "${1:-}" in
  tags|pristine|new|run|ssh|scp|grow|adduser|reset|rm) c="$1"; shift; "cmd_$c" "$@" ;;
  *) sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
