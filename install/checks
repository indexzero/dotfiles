#!/usr/bin/env zsh
#
# checks — small, eventually-consistent fixes for things installed by hand.
#
# Each check has a test and a fix. The test says whether the machine already
# has the thing; the fix is offered, never applied silently. Run it any time,
# on any machine, as often as you like. Add a check when a new machine makes
# you type the same one-off twice.
#
# Usage: install/checks            report, and offer each fix
#        install/checks --yes      apply every fix without asking
#        install/checks --list     names only

set -u

YES=""
case "${1:-}" in
  --yes|-y) YES=1 ;;
  --list)   grep -E '^check_[a-z_]+\(\)' "$0" | sed 's/^check_\([a-z_]*\)().*/\1/'; exit 0 ;;
  --help|-h) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  "") ;;
  *) echo "unknown option: $1" >&2; exit 1 ;;
esac

ok()   { print -r -- "  ✓  $*"; }
miss() { print -r -- "  ✗  $*"; }
fixed(){ print -r -- "  →  $*"; }

confirm() {
  [[ -n "$YES" ]] && return 0
  if command -v gum >/dev/null 2>&1; then
    gum confirm "$1"
  else
    local a; print -n -- "$1 [y/N] "; read -r a; [[ "$a" == [Yy]* ]]
  fi
}

# Every check: check_<name> returns 0 when the machine is fine. On failure
# it prints what is missing. fix_<name> does the one thing.
# --------------------------------------------------------------------------

# VS Code's `code` command. The cask links it into /opt/homebrew/bin; a dmg
# install does not. VS Code's own menu item writes to /usr/local/bin with
# sudo. ~/.local/bin is ours and already on PATH.
CODE_APP="/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code"
check_code_command() {
  [[ -x "$CODE_APP" ]] || { miss "VS Code is not installed (/Applications)"; return 2; }
  command -v code >/dev/null 2>&1 && return 0
  miss "code: VS Code is installed but \`code\` is not on PATH"
  return 1
}
fix_code_command() {
  mkdir -p "$HOME/.local/bin"
  ln -s "$CODE_APP" "$HOME/.local/bin/code"
  fixed "linked ~/.local/bin/code -> $CODE_APP"
}

# --------------------------------------------------------------------------
CHECKS=(code_command)

issues=0
for c in "${CHECKS[@]}"; do
  if "check_$c"; then
    ok "$c"
    continue
  fi
  rc=$?
  (( rc == 2 )) && continue            # the thing itself is absent; nothing to fix here
  issues=$(( issues + 1 ))
  if confirm "Fix $c?"; then
    "fix_$c" && issues=$(( issues - 1 ))
  fi
done

(( issues == 0 )) && echo "checks: all good" || echo "checks: $issues left"
exit $(( issues > 0 ))
