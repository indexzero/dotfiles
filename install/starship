#!/usr/bin/env zsh
set -e

DOTFILES="$(cd "${0:A:h}/.." && pwd)"
SRC="$DOTFILES/settings/starship"
DST="$HOME/Library/Application Support/starship"
BACK="$HOME/.backup/starship"

if [ -L "$DST" ]; then
  if [ "$(readlink "$DST")" = "$SRC" ]; then
    echo "Linked $DST -> $SRC (already)"
  else
    echo "Relinking $DST -> $SRC"
    rm "$DST" && ln -s "$SRC" "$DST"
  fi
elif [ -e "$DST" ]; then
  echo "Backing up existing $DST to $BACK"
  mkdir -p "$(dirname "$BACK")" && mv "$DST" "$BACK"
  ln -s "$SRC" "$DST"
else
  mkdir -p "$HOME/Library/Application Support"
  echo "Linking $DST -> $SRC"
  ln -s "$SRC" "$DST"
fi

if ! command -v starship >/dev/null 2>&1; then
  echo "Installing starship via brew..."
  brew install starship
fi

echo "starship $(starship --version)"
