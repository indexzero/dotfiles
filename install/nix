#!/usr/bin/env zsh
set -e

# Deploy from the installed clone, never from this checkout (see install/dotfiles).
# home-manager reads home.nix from here, so an edit reaches the machine only
# after it merges to main and `dotfiles pull` runs. Set DOTFILES_DIR to a
# checkout to deploy from it anyway.
DOTFILES="${DOTFILES_DIR:-$HOME/.local/share/dotfiles}"
[ -d "$DOTFILES/.git" ] || { echo "No installed clone at $DOTFILES; run install/dotfiles install first" >&2; exit 1; }
WORKSTATION="$DOTFILES/workstation"
[ -d "$WORKSTATION" ] || { echo "No workstation/ in $DOTFILES; merge it to main and run: dotfiles pull" >&2; exit 1; }

if ! command -v nix >/dev/null 2>&1; then
  echo "nix is not installed. Bootstrap first:"
  echo "  curl -fsSL https://install.determinate.systems/nix | sh -s -- install"
  echo "then see $WORKSTATION/README.md"
  exit 1
fi

# devenv reads devenv.nix from the working directory
cd "$WORKSTATION"

# Machines needs devenv >= 2.4 (`devenv version` prints "devenv 2.4.0 ...")
devenv_has_machines() {
  command -v devenv >/dev/null 2>&1 || return 1
  local v="$(devenv version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+' | head -1)"
  [[ -n "$v" ]] || return 1
  local major="${v%%.*}" minor="${v#*.}"
  (( major > 2 || (major == 2 && minor >= 4) ))
}

if devenv_has_machines; then
  devenv machines deploy cjr "$@"
else
  # First run: one-shot devenv from nixpkgs-unstable (2.4.0+). Never
  # `nix profile install` it: home-manager also manages the user profile
  # and the two collide. After this deploy, home.packages provides devenv.
  nix run github:NixOS/nixpkgs/nixpkgs-unstable#devenv -- machines deploy cjr "$@"
fi

echo "Deployed. Rollback: home-manager generations (Machines has no automatic rollback for home-manager)"
