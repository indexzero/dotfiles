#!/usr/bin/env zsh

# vale — prose linter with the Syntaf/vale-llm-slop style package.
# Links settings/vale as the global fallback config (used when a project has
# no .vale.ini), installs vale via brew if missing, then syncs style packages.
# Idempotent — safe to re-run. Per-project config lives in templates/.vale.ini.

set -e

DOTFILES="$(cd "${0:A:h}/.." && pwd)"
SRC="$DOTFILES/settings/vale"
DST="$HOME/Library/Application Support/vale"
BACK="$HOME/.backup/vale"

if [ -L "$DST" ]; then
  if [ "$(readlink "$DST")" = "$SRC" ]; then
    echo "Linked $DST -> $SRC (already)"
  else
    echo "Relinking $DST -> $SRC"
    rm "$DST" && ln -s "$SRC" "$DST"
  fi
elif [ -e "$DST" ]; then
  echo "Backing up existing $DST to $BACK"
  mkdir -p "$(dirname "$BACK")" && mv "$DST" "$BACK"
  ln -s "$SRC" "$DST"
else
  mkdir -p "$HOME/Library/Application Support"
  echo "Linking $DST -> $SRC"
  ln -s "$SRC" "$DST"
fi

if ! command -v vale >/dev/null 2>&1; then
  echo "Installing vale via brew..."
  brew install vale
fi

echo "Syncing vale style packages (vale-llm-slop)..."
vale --config "$SRC/.vale.ini" sync

echo "vale $(vale --version)"
