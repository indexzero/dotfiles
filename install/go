#!/usr/bin/env zsh

# go — global Go tools via `go install`.
#
# Go itself comes from mise (settings/mise/config.toml pins the bootstrap
# minor; GOTOOLCHAIN=auto fetches newer per module). The Homebrew Go this
# script used to manage was retired in 2026.05.03. PATH for ~/go/bin lives in
# dotfiles/.exports; nothing here edits a shell rc file, since ~/.zshrc is a
# symlink into the installed clone.
#
# Usage: install/go [--upgrade]
#   --upgrade, -u   Reinstall tools that are already present (pulls latest)

set -e

# -----------------------------------------------------------------------------
# Configuration
# -----------------------------------------------------------------------------

# Most tools float on @latest: they are read-only developer CLIs where the
# churn of hand-bumping pins outweighs the risk. Tools that hold credentials
# are pinned to an explicit tag and bumped deliberately.
GO_TOOLS=(
  "github.com/charmbracelet/glow/v2@latest"
  "github.com/mabd-dev/reposcan@latest"
  # main package moved to cmd/gits (v0.25)
  "github.com/rafi/gits/cmd/gits@latest"
  "github.com/chainguard-dev/yam@latest"
  "github.com/indexzero/skiffs@latest"
  # Pinned: reads API keys from ~/.config/fabric/.env, and upstream
  # auto-releases on nearly every merge (~1 tag/day).
  "github.com/danielmiessler/fabric/cmd/fabric@v1.4.470"
)

# -----------------------------------------------------------------------------
# Arguments
# -----------------------------------------------------------------------------

UPGRADE=""
case "${1:-}" in
  --upgrade|-u) UPGRADE=1 ;;
  --help|-h)
    echo "Usage: $0 [--upgrade]"
    echo "  --upgrade, -u   Reinstall tools that are already present (pulls latest)"
    echo ""
    echo "Go tools:"
    for tool in "${GO_TOOLS[@]}"; do echo "  - $tool"; done
    exit 0 ;;
  "") ;;
  *) echo "Unknown option: $1"; exit 1 ;;
esac

# -----------------------------------------------------------------------------
# Go
# -----------------------------------------------------------------------------

if ! command -v go >/dev/null 2>&1; then
  echo "go is not on PATH; it comes from mise. Run install/mise first." >&2
  exit 1
fi
# Where `go install` puts binaries. Under mise, the go shim sets GOBIN to
# mise's install dir and exposes binaries through shims after a reshim;
# `go env GOBIN` reports it even when the variable is not in this process.
GOBIN_DIR="$(go env GOBIN)"
[[ -n "$GOBIN_DIR" ]] || GOBIN_DIR="$(go env GOPATH)/bin"
echo "Go: $(go version | awk '{print $3}')  GOBIN: $GOBIN_DIR"
export PATH="$PATH:$GOBIN_DIR"

# The binary name: strip @version, then a /vN major suffix, then the path.
# github.com/charmbracelet/glow/v2@latest -> glow, not v2.
tool_bin_name() {
  local p="${1%%@*}"
  p="${p%/v[0-9]*}"
  print -r -- "${p##*/}"
}

# -----------------------------------------------------------------------------
# Tools
# -----------------------------------------------------------------------------

echo "Installing Go tools..."
for tool in "${GO_TOOLS[@]}"; do
  name="$(tool_bin_name "$tool")"
  if [[ -z "$UPGRADE" ]] && command -v "$name" >/dev/null 2>&1; then
    echo "  go -> $name (present)"
    continue
  fi
  echo "  go -> $tool"
  go install "$tool"
done
# New binaries in mise's GOBIN need shims before other shells see them.
command -v mise >/dev/null 2>&1 && mise reshim

echo ""
echo "Installed tools:"
for tool in "${GO_TOOLS[@]}"; do
  name="$(tool_bin_name "$tool")"
  if command -v "$name" >/dev/null 2>&1; then
    echo "  ✓ $name: $(command -v "$name")"
  else
    echo "  ✗ $name: not found on PATH"
  fi
done
echo ""
echo "Tool usage:"
echo "  glow README.md                 # Render markdown in the terminal"
echo ""
echo "  reposcan -r ~/Git              # Scan repos for uncommitted/unpushed changes"
echo "  reposcan -r ~/Git --filter dirty"
echo "  reposcan -r ~/Git --output json"
echo ""
echo "  skiffs -r ~/Git                # Scan repos for uncommitted/unpushed changes"
echo "  skiffs -r ~/Git --filter dirty"
echo "  skiffs -r ~/Git --output json"
echo "  skiffs prune                   # Find local branches safe to delete"
echo ""
echo "  gits status ~/Git              # Show status of all repos"
echo "  gits list                      # List configured projects"
echo ""
echo "  yam <file.yaml>                # YAML formatter"
echo ""
echo "  fabric --setup                 # Configure providers/API keys (~/.config/fabric)"
echo "  fabric -U                      # Update the patterns library"
echo "  pbpaste | fabric -p summarize  # Run a pattern over stdin"
