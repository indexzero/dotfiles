# Development Tools

tap "unhappychoice/tap"

brew "gcc"
brew "cmake"
brew "mise"   # replaces pyenv + volta + homebrew go — run install/mise after brew bundle
brew "pipx"
brew "zig"
brew "ripgrep"
brew "ast-grep"
brew "diff-so-fancy"
brew "gitlogue"
brew "mkcert"
tap "manaflow-ai/cmux"
# Ghostty-based terminal with vertical tabs and notifications for AI coding agents
cask "cmux"
