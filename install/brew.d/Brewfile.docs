# Documentation & Visualization

# LaTeX tools
brew "tectonic"
brew "poppler"
brew "latexindent"

# Diagrams and recordings
brew "d2"
brew "graphviz"
brew "vhs"
# No tap line on purpose: `brew tap charmbracelet/tap` fails Homebrew's
# tap-wide syntax check (tone.rb is empty upstream, 2026-10-21), while
# `brew install` auto-taps without that check. install/brew still trusts the
# tap from the qualified name below. brewwr would add the line back; don't.
brew "charmbracelet/tap/freeze"

# PDF tools
brew "pandoc"
brew "qpdf"

# Prose linting
brew "vale"
# Plain text note-taking assistant
brew "zk"
