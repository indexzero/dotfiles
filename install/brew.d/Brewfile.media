# Media Processing

brew "imagemagick"
brew "ffmpeg"
brew "librsvg"
brew "flac"
brew "mp3val"
brew "media-info"
brew "exiftool"
brew "clamav"

# Vector editing — node-level SVG editor; potrace front-end via Trace Bitmap
cask "inkscape"
# PNG file optimizer
brew "optipng"
# Recompression utilities for .PNG, .MNG, .ZIP, and .GZ files
brew "advancecomp"
# PDF reader for terminal emulators using the Kitty image protocol
brew "fancy-cat"
