#!/usr/bin/env zsh
set -e

# Link from the installed clone, never from this checkout (see install/dotfiles)
DOTFILES="${DOTFILES_DIR:-$HOME/.local/share/dotfiles}"
[ -d "$DOTFILES/.git" ] || { echo "No installed clone at $DOTFILES; run install/dotfiles install first" >&2; exit 1; }
SRC="$DOTFILES/settings/worktrunk/config.toml"
# worktrunk follows XDG_CONFIG_HOME (see dotfiles/.exports, which points it at
# ~/Library/Application Support on macOS). Resolve the destination the same way
# so our symlink lands where `wt` actually reads its config.
DST_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/worktrunk"
DST="$DST_DIR/config.toml"
BACK="$HOME/.backup/worktrunk-config.toml"

if ! command -v wt >/dev/null 2>&1; then
  echo "Installing worktrunk via brew..."
  brew install worktrunk
fi

echo "worktrunk $(wt --version 2>/dev/null || echo '(version unknown)')"

mkdir -p "$DST_DIR"

if [ -L "$DST" ]; then
  if [ "$(readlink "$DST")" = "$SRC" ]; then
    echo "Linked $DST -> $SRC (already)"
    exit 0
  fi
  rm "$DST"
elif [ -f "$DST" ]; then
  echo "Backing up existing $DST to $BACK"
  cp "$DST" "$BACK"
  rm "$DST"
fi

echo "Linking $DST -> $SRC"
ln -s "$SRC" "$DST"
