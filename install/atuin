#!/usr/bin/env bash

# atuin — shell history. The upstream installer puts the binary in
# ~/.atuin/bin; .zshrc sources its env and runs `atuin init zsh`.

set -e

if command -v atuin >/dev/null 2>&1 || [ -x "$HOME/.atuin/bin/atuin" ]; then
  echo "atuin present: $("$HOME/.atuin/bin/atuin" --version 2>/dev/null || atuin --version)"
else
  # --non-interactive: no history-import, sync, AI or daemon questions; the
  # defaults are the answers (skip). Agent hooks are handled below.
  curl --proto '=https' --tlsv1.2 -LsSf https://setup.atuin.sh | sh -s -- --non-interactive
fi
export PATH="$HOME/.atuin/bin:$PATH"

# Agent hooks, one per agent that is installed. Each writes to that agent's
# own config: claude-code -> ~/.claude/settings.json, codex -> ~/.codex/hooks.json,
# pi -> ~/.pi/agent/extensions/atuin.ts. Written as if/then on purpose: a
# trailing `command -v x && ...` leaves the script's exit status at 1 when x
# is absent, and the bootstrap reads that as a failed step.
for agent in claude-code:claude codex:codex pi:pi; do
  hook="${agent%%:*}"; bin="${agent##*:}"
  if command -v "$bin" >/dev/null 2>&1; then
    atuin hook install "$hook"
  else
    echo "atuin hook for $hook skipped: $bin not installed"
  fi
done
