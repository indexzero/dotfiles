#!/usr/bin/env zsh

# python — uv and the global Python tools it manages.
#
# Python itself comes from mise (settings/mise/config.toml); pyenv was retired
# in 2026.05.03. uv installs to ~/.local/bin on purpose: its installer would
# otherwise follow XDG_DATA_HOME to ~/Library/bin, which is on no PATH, and it
# must not edit ~/.zshrc, which is a symlink into the installed clone.

set -e

UPGRADE=""
case "${1:-}" in
  --upgrade|-u) UPGRADE=1 ;;
  --help|-h)
    echo "Usage: $0 [--upgrade]"
    echo "  --upgrade, -u   Reinstall tools that are already present (pulls latest)"
    exit 0 ;;
esac

export PATH="$HOME/.local/bin:$PATH"
# uv puts tool executables under XDG_DATA_HOME/../bin, which is ~/Library/bin
# here and on no PATH. Pin them next to uv itself. .exports sets the same for
# interactive `uv tool install`.
export UV_TOOL_BIN_DIR="$HOME/.local/bin"

if ! command -v uv >/dev/null 2>&1; then
  echo "Installing uv..."
  curl -LsSf https://astral.sh/uv/install.sh \
    | UV_INSTALL_DIR="$HOME/.local/bin" UV_NO_MODIFY_PATH=1 sh
fi
echo "uv: $(uv --version)"

# Global Python tools, one isolated environment each. Present tools are
# skipped unless --upgrade, like install/npm, install/go and install/cargo.
#
# They run on their own Python, one minor behind latest, not on mise's
# `python = "latest"`. A new minor ships before the ecosystem has wheels
# for it; aider's tiktoken pin had none for 3.15 and uv fell back to a
# source build that PyO3 refused. uv downloads this version itself.
# Bump deliberately, after the tools below install cleanly on it.
UV_TOOL_PYTHON="3.14"

UV_TOOLS=(
  poetry
  pipreqs      # pipreqs ./  — minimal requirements.txt for the project
  pipdeptree   # pipdeptree --warn silence > dependency_tree.txt
)

INSTALLED="$(uv tool list 2>/dev/null | awk 'NF && $1 !~ /^-/ {print $1}')"
for tool in "${UV_TOOLS[@]}"; do
  if [[ -z "$UPGRADE" && $'\n'"$INSTALLED"$'\n' == *$'\n'"$tool"$'\n'* ]]; then
    echo "  uv -> $tool (present)"
    continue
  fi
  echo "  uv -> $tool (python $UV_TOOL_PYTHON)"
  uv tool install --upgrade --python "$UV_TOOL_PYTHON" "$tool"
done
