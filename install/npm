#!/bin/zsh

# npm — install global npm-ecosystem packages from install/npm.d/globals.<set>.
#
# Each non-comment line is "<manager> <pkg>" where manager ∈ npm | pnpm | bun.
# Mirrors install/brew + brew.d. Use scripts/npmwr to add/remove entries so the
# globals files stay in sync with the host.

set -e

SCRIPT_DIR="${0:A:h}"
NPM_D="$SCRIPT_DIR/npm.d"

# Parse options
SET=""
while [[ $# -gt 0 ]]; do
    case $1 in
        --set|-s)
            SET="$2"
            shift 2
            ;;
        --help|-h)
            echo "Usage: $0 [options]"
            echo "Options:"
            echo "  --set, -s <name>  Install only globals.<name> (cli, dev, llms, docs, ...)"
            echo "  --help, -h        Show this help message"
            echo ""
            echo "Without options, installs every set in $NPM_D."
            echo "Manage entries with: scripts/npmwr install|uninstall|sets"
            exit 0
            ;;
        *)
            echo "Unknown option: $1"
            echo "Use --help for usage information"
            exit 1
            ;;
    esac
done

# ~/.npmrc first. dotfiles/.security exports npm_config_* for interactive
# shells; a non-interactive run (the bootstrap) has none of them, and a global
# install with scripts enabled is exactly the hole .security closes. Write the
# same keys into ~/.npmrc so they hold for every npm invocation, plus the
# prefix that keeps globals in ~/.local/bin across mise node versions.
# `npm config set` edits ~/.npmrc in place; other keys (auth tokens) stay.
SECURITY="$SCRIPT_DIR/../dotfiles/.security"
ensure_npmrc() {
    echo "Applying ${SECURITY:t} to ~/.npmrc..."
    local line key val
    while IFS= read -r line; do
        [[ "$line" == export\ npm_config_* ]] || continue
        key="${line#export npm_config_}"; key="${key%%=*}"; key="${key//_/-}"
        val="${line#*=}"; val="${val#\'}"; val="${val%\'}"
        npm config set --location=user "$key" "$val"
    done < "$SECURITY"
    npm config set --location=user prefix "$HOME/.local"
}

# pnpm comes from npm, so it must exist before any "pnpm" line. bun comes from
# mise. PNPM_HOME mirrors .zshrc so `pnpm add -g` has a global bin dir here;
# pnpm >= 11 uses $PNPM_HOME/bin and refuses to add globals unless it is on
# PATH, pnpm <= 10 uses $PNPM_HOME, so both are added like .zshrc does.
export PNPM_HOME="${PNPM_HOME:-$HOME/Library/pnpm}"
export PATH="$PNPM_HOME/bin:$PNPM_HOME:$HOME/.local/bin:$PATH"
ensure_managers() {
    if ! command -v pnpm >/dev/null 2>&1; then
        echo "Installing pnpm with npm..."
        npm install -g pnpm
    fi
    command -v bun >/dev/null 2>&1 || echo "warning: bun not found (mise installs it); bun lines will fail" >&2
}

install_pkg() {
    local mgr="$1" pkg="$2"
    echo "  $mgr -> $pkg"
    case "$mgr" in
        npm)  npm install -g "$pkg" ;;
        pnpm) pnpm add -g "$pkg" ;;
        bun)  bun add -g "$pkg" ;;
        *)    echo "  skipping unknown manager: $mgr" >&2 ;;
    esac
}

install_file() {
    local file="$1"
    [[ -f "$file" ]] || { echo "Error: no such set file: $file" >&2; exit 1; }
    echo "Installing from ${file##*/}..."
    # Read manager + pkg, skipping blank lines and comments.
    local mgr pkg _rest
    while read -r mgr pkg _rest; do
        [[ -z "$mgr" || "$mgr" == \#* ]] && continue
        [[ -n "$pkg" ]] || continue
        install_pkg "$mgr" "$pkg"
    done < "$file"
}

ensure_npmrc
ensure_managers

if [[ -n "$SET" ]]; then
    install_file "$NPM_D/globals.$SET"
else
    for f in "$NPM_D"/globals.*; do
        [[ -e "$f" ]] || continue
        install_file "$f"
    done
fi

echo "Installation complete!"
