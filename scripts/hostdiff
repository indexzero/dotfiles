#!/usr/bin/env bash
# hostdiff - Diff this dotfiles repo against the current machine
# Usage: hostdiff [-v|--verbose] [doctor|clone|files|symlinks|brew|mise|all]
#        hostdiff ingest [--apply]
#   default (doctor): problems-only health check — hides ✓/- , shows only fixes
#   -v / all:         full per-lens listing, including ✓ matches
#   ingest:           print local edits ($HOME and the installed clone) as a
#                     patch against the repo; --apply applies it to the dev
#                     checkout ($DOTFILES_HOME) for review and commit
set -euo pipefail

DOTFILES="$(cd "$(dirname "$0")/.." && pwd)"

# The installed, read-only clone that $HOME links into (see install/dotfiles)
# and the dev checkout where changes are authored. Once the clone exists, every
# lens compares $HOME against it rather than against wherever this script runs.
CLONE="${DOTFILES_DIR:-$HOME/.local/share/dotfiles}"
DEV="${DOTFILES_HOME:-$HOME/Git/indexzero/dotfiles}"
[[ -d "$CLONE/.git" ]] && DOTFILES="$CLONE"

# ── Visual language ───────────────────────────────────────────────────────────
# ✓  green  — matches
# ~  yellow — differs
# ✗  red    — missing entirely
# -  dim    — skipped (tool not available)
#
# Symbol grammar:
#   →   symlink currently points to (only here)
#   $   shell command to run to fix
#   -/+ removed/added lines in a diff

# In doctor mode (default) only problems print: ✓/- are hidden and section
# headers appear lazily, the first time a problem lands under them. -v/all
# restores the full per-lens listing. _ISSUES tallies the doctor summary.
VERBOSE=0
_ISSUES=0
_PENDING=""

_flush()   { [[ -n "$_PENDING" ]] && printf "\n\033[1m── %s\033[0m\n" "$_PENDING"; _PENDING=""; }
_section() { _PENDING="$*"; [[ $VERBOSE == 1 ]] && _flush; return 0; }

_ok()      { [[ $VERBOSE == 1 ]] || return 0; _flush; printf "  \033[2m✓  %s\033[0m\n" "$*"; }
_skip()    { [[ $VERBOSE == 1 ]] || return 0; _flush; printf "  \033[2m-  %s\033[0m\n" "$*"; }
_diff()    { _flush; _ISSUES=$((_ISSUES+1)); printf "  \033[33m~  %s\033[0m\n" "$*"; }
_missing() { _flush; _ISSUES=$((_ISSUES+1)); printf "  \033[31m✗  %s\033[0m\n" "$*"; }
_fix()     { printf "     \033[2m\$  %s\033[0m\n" "$*"; }

# ── Normalization ─────────────────────────────────────────────────────────────
# Lines allowed to differ: tools that append to shell files post-install
_dynamic_line() {
  local line="$1"
  [[ "$line" =~ 'wt config shell init' ]] && return 0
  [[ "$line" =~ 'GITHUB_TOKEN=' ]]        && return 0
  [[ "$line" =~ '# Added by ' ]]          && return 0
  return 1
}

_normalize() {
  local file="$1"
  while IFS= read -r line || [[ -n "$line" ]]; do
    _dynamic_line "$line" && continue
    printf '%s\n' "${line%"${line##*[![:space:]]}"}"
  done < "$file"
}

# ── File lens ─────────────────────────────────────────────────────────────────
check_files() {
  _section "dotfiles"
  local any_diff=0

  for src in "$DOTFILES/dotfiles"/.*; do
    [[ -f "$src" ]] || continue
    local file dst
    file="$(basename "$src")"
    dst="$HOME/$file"

    if [[ ! -e "$dst" && ! -L "$dst" ]]; then
      _missing "$file"
      _fix "zsh install/dotfiles link"
      any_diff=1
      continue
    fi

    # Linked into the clone: identical by construction. Local edits made
    # through the link show up in the clone lens instead.
    if [[ -L "$dst" ]]; then
      if [[ "$(readlink "$dst")" == "$src" ]]; then
        _ok "$file"
      else
        _diff "$file  (links elsewhere)"
        printf "     \033[2mis:   $(readlink "$dst")\033[0m\n"
        printf "     \033[2mwant: $src\033[0m\n"
        _fix "zsh install/dotfiles link"
        any_diff=1
      fi
      continue
    fi

    local src_norm dst_norm
    src_norm="$(_normalize "$src")"
    dst_norm="$(_normalize "$dst")"

    if [[ "$src_norm" == "$dst_norm" ]]; then
      _ok "$file"
    else
      _diff "$file"
      diff <(echo "$src_norm") <(echo "$dst_norm") \
        | grep '^[<>]' | head -12 \
        | sed 's|^< |     \x1b[31m- |; s|^> |     \x1b[32m+ |' \
        | while IFS= read -r l; do printf "%b\033[0m\n" "$l"; done
      _fix "hostdiff ingest --apply   # keep the + lines"
      _fix "zsh install/dotfiles link # then replace the copy with a link"
      any_diff=1
    fi
  done

  return $any_diff
}

# ── Clone lens ────────────────────────────────────────────────────────────────
# The clone should sit on main, match origin, and have no local edits. Edits
# arrive when something writes through a symlink (installers appending to
# ~/.zshrc, `git config --global`, an over-eager agent).
check_clone() {
  _section "clone"

  if [[ ! -d "$CLONE/.git" ]]; then
    _missing "no installed clone at $CLONE"
    _fix "zsh install/dotfiles install"
    return 1
  fi

  local rc=0 branch ahead dirty
  branch="$(git -C "$CLONE" symbolic-ref --short -q HEAD || echo '(detached)')"
  if [[ "$branch" == main ]]; then
    _ok "on main @ $(git -C "$CLONE" rev-parse --short HEAD)"
  else
    _diff "on $branch, not main"
    _fix "git -C \"$CLONE\" switch main"
    rc=1
  fi

  ahead="$(git -C "$CLONE" rev-list --count origin/main..HEAD 2>/dev/null || echo 0)"
  if [[ "$ahead" != 0 ]]; then
    _diff "$ahead local commit(s) not on origin/main"
    _fix "git -C \"$CLONE\" log origin/main..HEAD"
    rc=1
  fi

  dirty="$(git -C "$CLONE" status --porcelain)"
  if [[ -z "$dirty" ]]; then
    _ok "no local edits"
  else
    while IFS= read -r line; do _diff "edited: ${line:3}"; done <<< "$dirty"
    _fix "hostdiff ingest            # review the patch"
    _fix "hostdiff ingest --apply    # copy it into $DEV"
    rc=1
  fi

  if [[ -n "$(git -C "$CLONE" stash list)" ]]; then
    _diff "stashed edits left by an earlier 'dotfiles pull'"
    _fix "git -C \"$CLONE\" stash show -p --include-untracked"
    rc=1
  fi

  return $rc
}

# ── Ingest ────────────────────────────────────────────────────────────────────
# Emit one patch, relative to the repo root, covering:
#   1. tracked and untracked edits inside the installed clone
#   2. real files in $HOME that shadow a dotfiles/ entry (pre-symlink copies,
#      or links some tool replaced with a file via write-and-rename)
# Lines in $HOME but not the repo show as +; lines only in the repo show as -.
_ingest_patch() {
  if [[ -d "$CLONE/.git" && "$DOTFILES" == "$CLONE" ]]; then
    git -C "$CLONE" --no-pager diff --no-color HEAD
    git -C "$CLONE" ls-files --others --exclude-standard -z \
      | while IFS= read -r -d '' rel; do
          diff -u --label /dev/null --label "b/$rel" /dev/null "$CLONE/$rel" || true
        done
  fi

  local src rel dst
  while IFS= read -r -d '' src; do
    rel="${src#"$DOTFILES"/}"
    dst="$HOME/${rel#dotfiles/}"
    [[ -f "$dst" && ! -L "$dst" ]] || continue
    diff -u --label "a/$rel" --label "b/$rel" "$src" "$dst" || true
  done < <(find "$DOTFILES/dotfiles" -type f -print0)
}

cmd_ingest() {
  local apply="${1:-}" patch
  patch="$(mktemp -t hostdiff-ingest)"
  _ingest_patch > "$patch"

  if [[ ! -s "$patch" ]]; then
    echo "Nothing to ingest: \$HOME and $DOTFILES match the repo."
    rm -f "$patch"
    return 0
  fi

  if [[ "$apply" != --apply ]]; then
    cat "$patch"
    rm -f "$patch"
    return 0
  fi

  [[ -d "$DEV/.git" ]] || { echo "hostdiff: no dev checkout at $DEV (set DOTFILES_HOME)" >&2; return 1; }
  # Plain apply leaves the result unstaged for review; --3way (which stages)
  # is the fallback when the dev checkout has moved on.
  if git -C "$DEV" apply "$patch" 2>/dev/null || git -C "$DEV" apply --3way "$patch"; then
    rm -f "$patch"
    echo "Applied to $DEV. Review with: git -C \"$DEV\" diff"
    echo "Once merged to main, 'dotfiles pull' brings the clone back to clean."
  else
    echo "hostdiff: patch did not apply cleanly; kept at $patch" >&2
    return 1
  fi
}

# ── Symlink lens ──────────────────────────────────────────────────────────────
check_symlinks() {
  _section "symlinks"

  _check_link() {
    local _lname="$1" _src="$2" _dst="$3" _cmd="${4:-install/$1}"
    if [[ ! -e "$_dst" && ! -L "$_dst" ]]; then
      _missing "$_lname"
      _fix "zsh $_cmd"
    elif [[ ! -L "$_dst" ]]; then
      _diff "$_lname  (not a symlink)"
      _fix "zsh $_cmd"
    elif [[ "$(readlink "$_dst")" != "$_src" ]]; then
      _diff "$_lname"
      printf "     \033[2mis:   $(readlink "$_dst")\033[0m\n"
      printf "     \033[2mwant: $_src\033[0m\n"
      _fix "zsh $_cmd"
    else
      _ok "$_lname"
    fi
  }

  _check_link "ghostty"   "$DOTFILES/settings/ghostty"              "$HOME/Library/Application Support/com.mitchellh.ghostty"
  _check_link "mise"      "$DOTFILES/settings/mise"                 "$HOME/Library/Application Support/mise"
  _check_link "starship"  "$DOTFILES/settings/starship"             "$HOME/Library/Application Support/starship"
  _check_link "worktrunk" "$DOTFILES/settings/worktrunk/config.toml" "${XDG_CONFIG_HOME:-$HOME/.config}/worktrunk/config.toml" "install/worktrunk"
}

# ── Brew lens ─────────────────────────────────────────────────────────────────
check_brew() {
  _section "brew"

  if ! command -v brew >/dev/null 2>&1; then
    _skip "brew not installed"
    return
  fi

  local brewfile_dir="$DOTFILES/install/brew.d"
  local any_diff=0

  # Sets the machine profile omits (install/bootstrap.zsh records the profile;
  # brew.d/profiles maps it). Those are not drift on this machine.
  local profile_file="${XDG_CONFIG_HOME:-$HOME/Library/Application Support}/dotfiles/profile"
  local profile="" omitted=""
  if [[ -f "$profile_file" ]]; then
    profile="$(tr -d '[:space:]' < "$profile_file")"
    omitted="$(awk -v p="$profile" '$1 == p { $1 = ""; print }' "$brewfile_dir/profiles")"
  fi

  for brewfile in "$brewfile_dir"/Brewfile.*; do
    local bfname out
    bfname="$(basename "$brewfile")"
    if [[ " ${omitted} " == *" ${bfname#Brewfile.} "* ]]; then
      _skip "$bfname (omitted by profile $profile)"
      continue
    fi
    if out="$(brew bundle check --verbose --file="$brewfile" 2>&1)"; then
      _ok "$bfname"
    else
      _diff "$bfname"
      # Keep only the actionable "→ Formula/Cask X needs ..." lines; everything
      # else is Homebrew auto-update / tap chatter we don't want in doctor output.
      echo "$out" \
        | grep '→' \
        | sed 's/^[[:space:]]*→ /     \x1b[31m✗  /' \
        | while IFS= read -r l; do printf "%b\033[0m\n" "$l"; done
      _fix "brew bundle install --file=$brewfile"
      any_diff=1
    fi
  done

  return $any_diff
}

# ── Mise lens ─────────────────────────────────────────────────────────────────
check_mise() {
  _section "mise"

  if ! command -v mise >/dev/null 2>&1; then
    _skip "mise not installed"
    return
  fi

  local missing_tools
  missing_tools="$(XDG_CONFIG_HOME="$HOME/Library/Application Support" \
    MISE_DATA_DIR="$HOME/.local/share/mise" \
    mise ls --missing 2>/dev/null | grep -v '^$' || true)"

  if [[ -z "$missing_tools" ]]; then
    _ok "all tools installed"
  else
    while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      _missing "$line"
    done <<< "$missing_tools"
    _fix "mise install"
  fi
}

# ── Dispatch ──────────────────────────────────────────────────────────────────
_usage() {
  echo "Usage: hostdiff [-v|--verbose] [doctor|clone|files|symlinks|brew|mise|all]" >&2
  echo "       hostdiff ingest [--apply]" >&2
}

if [[ "${1:-}" == ingest ]]; then
  shift
  cmd_ingest "$@"
  exit $?
fi

MODE=""
for arg in "$@"; do
  case "$arg" in
    -v|--verbose)                       VERBOSE=1 ;;
    -h|--help)                          _usage; exit 0 ;;
    doctor|clone|files|symlinks|brew|mise|all) MODE="$arg" ;;
    *)                                  _usage; exit 1 ;;
  esac
done
MODE="${MODE:-doctor}"
[[ "$MODE" == all ]] && VERBOSE=1   # `all` is the full, verbose listing

EXIT=0
ALL=0

case "$MODE" in
  clone)    check_clone    || EXIT=1 ;;
  files)    check_files    || EXIT=1 ;;
  symlinks) check_symlinks || EXIT=1 ;;
  brew)     check_brew     || EXIT=1 ;;
  mise)     check_mise     || EXIT=1 ;;
  doctor|all)
    ALL=1
    [[ $VERBOSE == 1 ]] || printf "\n\033[1m══ hostdiff doctor ══\033[0m\n"
    check_clone    || EXIT=1
    check_files    || EXIT=1
    check_symlinks || EXIT=1
    check_brew     || EXIT=1
    check_mise     || EXIT=1
    ;;
esac

# Doctor summary (only when sweeping every lens)
if [[ $ALL == 1 ]]; then
  if   [[ $_ISSUES -eq 0 ]]; then printf "\n\033[2m✓ No issues — system healthy.\033[0m\n"
  elif [[ $_ISSUES -eq 1 ]]; then printf "\n\033[33m1 issue found.\033[0m System otherwise healthy.\n"
  else                            printf "\n\033[33m%d issues found.\033[0m\n" "$_ISSUES"
  fi
else
  echo ""
fi

exit $EXIT
