#!/usr/bin/env bash
# brewwr — brew write.
#
# Thin wrapper around `brew bundle add | remove | list` that keeps
# install/brew.d/Brewfile.<set> in sync with the host. Adds: set
# selection (gum), cross-set conflict detection, and a `dist(brew)`
# auto-commit. Delegates all Brewfile mutation to brew bundle.
#
# Usage: brewwr <install|uninstall|sets> [args]

set -euo pipefail

# ---------- self-location ----------

self_path() {
  local s="${BASH_SOURCE[0]}"
  while [ -L "$s" ]; do
    local target
    target="$(readlink "$s")"
    case "$target" in
      /*) s="$target" ;;
      *)  s="$(cd "$(dirname "$s")" && pwd)/$target" ;;
    esac
  done
  printf '%s\n' "$s"
}

resolve_dotfiles_home() {
  local script_dir candidate
  script_dir="$(cd "$(dirname "$(self_path)")" && pwd)"
  if candidate="$(git -C "$script_dir" rev-parse --show-toplevel 2>/dev/null)" \
      && [ -d "$candidate/install/brew.d" ]; then
    printf '%s\n' "$candidate"
    return 0
  fi
  if [ -n "${DOTFILES_HOME:-}" ] && [ -d "$DOTFILES_HOME/install/brew.d" ]; then
    printf '%s\n' "$DOTFILES_HOME"
    return 0
  fi
  return 1
}

# ---------- helpers ----------

die() { printf 'brewwr: %s\n' "$*" >&2; exit "${EXIT:-1}"; }

require() {
  command -v "$1" >/dev/null 2>&1 \
    || { EXIT=1 die "required command '$1' not on PATH${2:+ ($2)}"; }
}

is_tty() { [ -t 0 ] && [ -t 1 ]; }

# Append a newline if the file is non-empty and lacks a trailing one.
ensure_trailing_newline() {
  local f="$1"
  [ -s "$f" ] || return 0
  [ -z "$(tail -c1 -- "$f")" ] || printf '\n' >> "$f"
}

brewfile_dir()        { printf '%s/install/brew.d\n' "$DOTFILES_HOME"; }
brewfile_for_set()    { printf '%s/Brewfile.%s\n' "$(brewfile_dir)" "$1"; }
brewfile_rel_for_set(){ printf 'install/brew.d/Brewfile.%s\n' "$1"; }

# Iterate set names (suffix only), excluding the aggregator Brewfile.
list_set_names() {
  local f base
  for f in "$(brewfile_dir)"/Brewfile.*; do
    [ -e "$f" ] || continue
    base="${f##*/}"
    printf '%s\n' "${base#Brewfile.}"
  done
}

set_description() {
  local line
  line="$(grep -m1 '^# ' "$1" 2>/dev/null || true)"
  printf '%s\n' "${line#\# }"
}

# `brew bundle list` is ruby-heavy and we scan every set, so build a set/entry
# index once per run and answer lookups from it. One "<set>\t<entry>" record
# per line.
BREW_INDEX=''
BREW_INDEX_BUILT=0

build_brew_index() {
  [ "$BREW_INDEX_BUILT" -eq 0 ] || return 0
  local name file entry
  while IFS= read -r name; do
    file="$(brewfile_for_set "$name")"
    while IFS= read -r entry; do
      [ -n "$entry" ] || continue
      BREW_INDEX="${BREW_INDEX}${name}"$'\t'"${entry}"$'\n'
    done < <(brew bundle list --all --file="$file")
  done < <(list_set_names)
  BREW_INDEX_BUILT=1
}

invalidate_brew_index() { BREW_INDEX=''; BREW_INDEX_BUILT=0; }

# Lists set names that contain <pkg>, one per line. Empty output = not found.
find_sets_for_pkg() {
  local pkg="$1"
  build_brew_index
  printf '%s' "$BREW_INDEX" \
    | awk -F'\t' -v pkg="$pkg" '$2 == pkg { print $1 }'
}

# Determine which kind (--formula | --cask | --tap) a pkg currently has in a
# given Brewfile. Empty output = not present.
detect_kind_in_file() {
  local pkg="$1" file="$2" kind
  for kind in formulae casks taps; do
    if brew bundle list "--$kind" --file="$file" \
        | grep -Fxq -- "$pkg"; then
      case "$kind" in
        formulae) printf 'formula\n' ;;
        casks)    printf 'cask\n' ;;
        taps)     printf 'tap\n' ;;
      esac
      return 0
    fi
  done
}

# Resolve formula-vs-cask for a fully-qualified user/tap/name from the tap's
# own index. Prefer this over `brew info` for qualified names: `brew tap-info`
# reads names without loading the tap's Ruby, so it works on an untrusted tap,
# and a name that simply is not there gives a precise error instead of brew
# globbing the tap, loading an unrelated formula, and failing the trust check
# on that -- which reads as a trust problem when it is really a typo.
kind_from_tap_index() {
  local pkg="$1" tap="$2" json is_formula is_cask
  json="$(brew tap-info --json "$tap" 2>/dev/null || true)"
  [ -n "$json" ] || { EXIT=3 die "brew tap-info '$tap' failed"; }

  is_formula="$(printf '%s' "$json" \
    | jq --arg p "$pkg" '[.[0].formula_names[]? | select(. == $p)] | length')"
  is_cask="$(printf '%s' "$json" \
    | jq --arg p "$pkg" '[.[0].cask_tokens[]?  | select(. == $p)] | length')"

  if [ "$is_formula" -gt 0 ] && [ "$is_cask" -gt 0 ]; then
    if is_tty; then
      gum choose --header "'$pkg' is both a formula and a cask in $tap. Which?" \
        formula cask
    else
      EXIT=2 die "'$pkg' is ambiguous (formula and cask exist); pass --formula or --cask"
    fi
    return 0
  fi
  [ "$is_formula" -eq 0 ] || { printf 'formula\n'; return 0; }
  [ "$is_cask"    -eq 0 ] || { printf 'cask\n';    return 0; }

  local provides
  provides="$(printf '%s' "$json" \
    | jq -r '.[0] | ((.formula_names // []) + (.cask_tokens // []))[]' \
    | sed 's/^/  /')"
  EXIT=3 die "'$pkg' is not in tap '$tap'."$'\n'"$tap provides:"$'\n'"${provides:-  (nothing)}"
}

# Decide kind for an install: explicit flag wins, else heuristic + brew info.
decide_install_kind() {
  local pkg="$1" forced="${2:-}"
  if [ -n "$forced" ]; then
    printf '%s\n' "$forced"
    return 0
  fi
  # user/repo with no third segment = a tap
  if [[ "$pkg" =~ ^[^/]+/[^/]+$ ]]; then
    printf 'tap\n'
    return 0
  fi
  # user/tap/name = a formula or cask from a third-party tap. `brew info`
  # (unlike `brew install`) refuses to auto-tap, so ensure the tap is present
  # before probing kind, otherwise the info call fails on an untapped repo.
  if [[ "$pkg" =~ ^([^/]+/[^/]+)/[^/]+$ ]]; then
    local tap="${BASH_REMATCH[1]}"
    if ! brew tap | grep -Fxq -- "$tap"; then
      printf "brewwr: tapping '%s' for '%s'...\n" "$tap" "$pkg" >&2
      brew tap "$tap" >&2 || { EXIT=3 die "brew tap '$tap' failed"; }
    fi
    kind_from_tap_index "$pkg" "$tap"
    return 0
  fi
  local json fcount ccount
  json="$(brew info --json=v2 "$pkg" || true)"
  [ -n "$json" ] || { EXIT=3 die "brew info '$pkg' failed (unknown package?)"; }
  fcount="$(printf '%s' "$json" | jq '.formulae | length')"
  ccount="$(printf '%s' "$json" | jq '.casks    | length')"
  if [ "$fcount" -gt 0 ] && [ "$ccount" -gt 0 ]; then
    if is_tty; then
      gum choose --header "'$pkg' resolves to both a formula and a cask. Which?" \
        formula cask
    else
      EXIT=2 die "'$pkg' is ambiguous (formula and cask exist); pass --formula or --cask"
    fi
  elif [ "$ccount" -gt 0 ]; then
    printf 'cask\n'
  elif [ "$fcount" -gt 0 ]; then
    printf 'formula\n'
  else
    EXIT=3 die "brew info '$pkg' returned no formula or cask"
  fi
}

kind_to_flag() {
  case "$1" in
    formula) printf -- '--formula\n' ;;
    cask)    printf -- '--cask\n' ;;
    tap)     printf -- '--tap\n' ;;
    *) EXIT=1 die "internal: unknown kind '$1'" ;;
  esac
}

prompt_set() {
  local name desc choices=() pick
  while IFS= read -r name; do
    desc="$(set_description "$(brewfile_for_set "$name")")"
    choices+=("$name — $desc")
  done < <(list_set_names)
  [ "${#choices[@]}" -gt 0 ] || { EXIT=1 die "no Brewfile.<set> files found in $(brewfile_dir)"; }
  pick="$(printf '%s\n' "${choices[@]}" | gum choose --header 'Which set?')"
  [ -n "$pick" ] || { EXIT=2 die 'no set selected'; }
  printf '%s\n' "${pick%% *}"
}

assert_brew_d_clean() {
  local dirty
  dirty="$(git -C "$DOTFILES_HOME" status --porcelain -- install/brew.d/)"
  [ -z "$dirty" ] \
    || { EXIT=6 die "install/brew.d/ has uncommitted changes; commit or stash first"$'\n'"$dirty"; }
}

commit_brewfile() {
  local action="$1" pkg="$2" set_name="$3"
  local rel; rel="$(brewfile_rel_for_set "$set_name")"
  git -C "$DOTFILES_HOME" add -- "$rel"
  if git -C "$DOTFILES_HOME" diff --cached --quiet -- "$rel"; then
    return 0
  fi
  local prep
  case "$action" in
    add)    prep='to' ;;
    remove) prep='from' ;;
    *) EXIT=1 die "internal: bad commit action '$action'" ;;
  esac
  git -C "$DOTFILES_HOME" commit -m "dist(brew) $action $pkg $prep Brewfile.$set_name" >/dev/null
  printf 'brewwr: committed %s %s %s Brewfile.%s\n' "$action" "$pkg" "$prep" "$set_name"
}

# A `user/repo/name` package also needs a `tap "user/repo"` line, or a fresh
# machine running `brew bundle install` can't resolve it. Note that `brew
# bundle add --tap` only writes the entry: unlike --formula/--cask it does not
# tap the host (Homebrew's bundle/adder.rb skips ensure_installed! for taps),
# so tap explicitly here.
#
# Unlike a formula, a tap already declared in *another* set is not a conflict —
# it only needs to appear once across the whole bundle.
ensure_tap_entry() {
  local tap="$1" set_name="$2" no_commit="$3" no_install="$4"
  local found file
  found="$(find_sets_for_pkg "$tap" | head -1)"
  if [ -n "$found" ]; then
    printf "brewwr: tap '%s' already in Brewfile.%s\n" "$tap" "$found" >&2
    return 0
  fi

  if [ "$no_install" -eq 0 ] && ! brew tap | grep -Fxq -- "$tap"; then
    printf "brewwr: tapping '%s' for '%s'...\n" "$tap" "$set_name" >&2
    brew tap "$tap" >&2 || { EXIT=3 die "brew tap '$tap' failed"; }
  fi

  file="$(brewfile_for_set "$set_name")"
  ensure_trailing_newline "$file"
  brew bundle add --tap --no-describe --file="$file" "$tap" \
    || { EXIT=3 die "brew bundle add --tap '$tap' failed"; }
  invalidate_brew_index

  # Commit now rather than batching with <pkg>: the tap is genuinely installed
  # and its entry stands on its own, so a later failure installing <pkg> must
  # not strand it uncommitted.
  if [ "$no_commit" -eq 0 ]; then
    commit_brewfile add "$tap" "$set_name"
  fi
}

# ---------- subcommand: install ----------

usage_install() {
  cat <<'EOF'
Usage: brewwr install <pkg> [flags]

Flags:
  -s, --set <name>   Target Brewfile.<name>. Prompts via gum if omitted.
      --cask         Force cask kind.
      --formula      Force formula kind.
      --tap          Force tap kind.
      --no-install   Write to Brewfile only; skip the install.
      --upgrade      After installing <pkg> and writing the Brewfile, run
                     `brew bundle install` against the file to upgrade anything
                     else that is outdated. (Default: install only <pkg>.)
      --no-tap-entry For a `user/repo/name` <pkg>, skip writing the companion
                     `tap "user/repo"` entry. (Default: write it.)
      --no-commit    Leave the diff in the working tree.
  -h, --help

A fully-qualified `user/repo/name` <pkg> writes two entries: the tap and the
formula/cask. Each is committed separately.
EOF
}

cmd_install() {
  local pkg='' set_name='' forced_kind='' no_install=0 upgrade=0 no_commit=0
  local no_tap_entry=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -s|--set)         set_name="$2"; shift 2 ;;
      --cask)           forced_kind='cask'; shift ;;
      --formula|--formulae) forced_kind='formula'; shift ;;
      --tap)            forced_kind='tap'; shift ;;
      --no-tap-entry)   no_tap_entry=1; shift ;;
      --no-install)     no_install=1; shift ;;
      --upgrade)        upgrade=1; shift ;;
      --no-upgrade)     upgrade=0; shift ;;
      --no-commit)      no_commit=1; shift ;;
      -h|--help)        usage_install; exit 0 ;;
      --)               shift; break ;;
      -*)               EXIT=2 die "unknown flag: $1" ;;
      *)
        [ -z "$pkg" ] || { EXIT=2 die "unexpected arg: $1"; }
        pkg="$1"; shift ;;
    esac
  done
  [ -n "$pkg" ] || { usage_install; EXIT=2 die 'missing <pkg>'; }

  if [ -z "$set_name" ]; then
    is_tty || { EXIT=2 die '--set is required when not running in a TTY'; }
    set_name="$(prompt_set)"
  fi
  local file; file="$(brewfile_for_set "$set_name")"
  [ -f "$file" ] || { EXIT=2 die "no such set: $set_name (try 'brewwr sets')"; }

  assert_brew_d_clean

  # A `user/repo/name` <pkg> implies a tap dependency. Record it up front, so
  # that the "already in Brewfile" early-exits below can't leave a package
  # entry whose tap was never written. Skipped when --tap forces the whole
  # string to be read as a tap in its own right.
  if [ "$no_tap_entry" -eq 0 ] && [ "$forced_kind" != 'tap' ] \
      && [[ "$pkg" =~ ^([^/]+/[^/]+)/[^/]+$ ]]; then
    ensure_tap_entry "${BASH_REMATCH[1]}" "$set_name" "$no_commit" "$no_install"
  fi

  # Cross-set conflict / idempotency.
  # `brew bundle list` is ruby-heavy and runs once per set, so this scan can
  # take several seconds with no output otherwise.
  printf "brewwr: scanning Brewfile.* for '%s'...\n" "$pkg" >&2
  local existing other_sets=() already_in_set=0
  while IFS= read -r existing; do
    [ -n "$existing" ] || continue
    if [ "$existing" = "$set_name" ]; then
      already_in_set=1
      continue
    fi
    other_sets+=("$existing")
  done < <(find_sets_for_pkg "$pkg")
  if [ "$already_in_set" -eq 1 ]; then
    # In the Brewfile — but is it actually installed on the host? Check before
    # declaring no-op, otherwise a half-applied prior run wedges us out.
    local existing_kind installed=0
    printf "brewwr: '%s' is in Brewfile.%s; checking host install state...\n" "$pkg" "$set_name" >&2
    existing_kind="$(detect_kind_in_file "$pkg" "$(brewfile_for_set "$set_name")")"
    case "$existing_kind" in
      formula) brew list --formula "$pkg" >/dev/null 2>&1 && installed=1 ;;
      cask)    brew list --cask    "$pkg" >/dev/null 2>&1 && installed=1 ;;
      tap)     brew tap | grep -Fxq -- "$pkg" && installed=1 ;;
    esac
    if [ "$installed" -eq 1 ] || [ "$no_install" -eq 1 ]; then
      printf "brewwr: '%s' already in Brewfile.%s — no-op\n" "$pkg" "$set_name"
      return 0
    fi
    printf "brewwr: warning: '%s' in Brewfile.%s but not installed on host — installing only %s\n" "$pkg" "$set_name" "$pkg" >&2
    case "$existing_kind" in
      tap)     brew tap "$pkg" ;;
      cask)    brew install --cask "$pkg" ;;
      formula) brew install "$pkg" ;;
    esac || { EXIT=3 die "brew install '$pkg' failed"; }
    return 0
  fi
  if [ "${#other_sets[@]}" -gt 0 ]; then
    EXIT=5 die "'$pkg' already in Brewfile.${other_sets[0]}; run 'brewwr uninstall --keep-installed $pkg' first, or target that set"
  fi

  local kind kind_flag
  kind="$(decide_install_kind "$pkg" "$forced_kind")"
  kind_flag="$(kind_to_flag "$kind")"

  # Guard: `brew bundle add` appends without inserting a leading newline if
  # the target file does not already end with one. Ensure trailing newline.
  ensure_trailing_newline "$file"

  if [ "$no_install" -eq 1 ]; then
    # Write only; never touch the host.
    brew bundle add "$kind_flag" --no-describe --file="$file" "$pkg" \
      || { EXIT=3 die 'brew bundle add failed'; }
  else
    # Install <pkg> first so a failure leaves the Brewfile untouched. Note:
    # `brew bundle add --install` runs install BEFORE appending the entry, so
    # the new package never gets installed — hence the explicit install here.
    case "$kind" in
      tap)     brew tap "$pkg" ;;
      cask)    brew install --cask "$pkg" ;;
      formula) brew install "$pkg" ;;
    esac || { EXIT=3 die "brew install '$pkg' failed; Brewfile entry for '$pkg' unchanged"; }
    brew bundle add "$kind_flag" --no-describe --file="$file" "$pkg" \
      || { EXIT=3 die 'brew bundle add failed'; }
    if [ "$upgrade" -eq 1 ]; then
      printf "brewwr: --upgrade: running 'brew bundle install --file=%s' (may upgrade other outdated entries)...\n" "$file" >&2
      brew bundle install --file="$file" \
        || { EXIT=3 die 'brew bundle install failed'; }
    fi
  fi

  # Note: `[ ... ] && commit_brewfile` here would make the function return 1
  # under --no-commit, which set -e turns into a failing exit for the whole run.
  if [ "$no_commit" -eq 0 ]; then
    commit_brewfile add "$pkg" "$set_name"
  fi
}

# ---------- subcommand: uninstall ----------

usage_uninstall() {
  cat <<'EOF'
Usage: brewwr uninstall <pkg> [flags]

Flags:
      --keep-installed  Remove from Brewfile but skip `brew uninstall`.
      --no-commit       Leave the diff in the working tree.
  -h, --help
EOF
}

cmd_uninstall() {
  local pkg='' keep_installed=0 no_commit=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --keep-installed) keep_installed=1; shift ;;
      --no-commit)      no_commit=1; shift ;;
      -h|--help)        usage_uninstall; exit 0 ;;
      --)               shift; break ;;
      -*)               EXIT=2 die "unknown flag: $1" ;;
      *)
        [ -z "$pkg" ] || { EXIT=2 die "unexpected arg: $1"; }
        pkg="$1"; shift ;;
    esac
  done
  [ -n "$pkg" ] || { usage_uninstall; EXIT=2 die 'missing <pkg>'; }

  local sets_found=()
  while IFS= read -r line; do sets_found+=("$line"); done < <(find_sets_for_pkg "$pkg")
  [ "${#sets_found[@]}" -gt 0 ] || { EXIT=4 die "'$pkg' not found in any Brewfile"; }

  local set_name
  if [ "${#sets_found[@]}" -eq 1 ]; then
    set_name="${sets_found[0]}"
  elif is_tty; then
    set_name="$(printf '%s\n' "${sets_found[@]}" \
      | gum choose --header "'$pkg' is in multiple sets. Remove from which?")"
    [ -n "$set_name" ] || { EXIT=2 die 'no set selected'; }
  else
    EXIT=2 die "'$pkg' in multiple sets (${sets_found[*]}); run in a TTY to disambiguate"
  fi

  local file kind kind_flag
  file="$(brewfile_for_set "$set_name")"
  kind="$(detect_kind_in_file "$pkg" "$file")"
  [ -n "$kind" ] || { EXIT=4 die "couldn't determine kind of '$pkg' in Brewfile.$set_name"; }
  kind_flag="$(kind_to_flag "$kind")"

  if is_tty; then
    local hint=''
    [ "$keep_installed" -eq 1 ] && hint=' (keep host install)'
    gum confirm "Remove '$pkg' from Brewfile.$set_name${hint}?" || {
      printf 'brewwr: aborted\n' >&2; exit 0
    }
  fi

  assert_brew_d_clean

  brew bundle remove "$kind_flag" --file="$file" "$pkg" \
    || { EXIT=3 die 'brew bundle remove failed'; }

  if [ "$keep_installed" -eq 0 ] && [ "$kind" != 'tap' ]; then
    local uninstall_args=()
    [ "$kind" = 'cask' ] && uninstall_args+=(--cask)
    brew uninstall "${uninstall_args[@]}" "$pkg" \
      || printf "brewwr: 'brew uninstall %s' reported an issue (continuing)\n" "$pkg" >&2
  fi

  if [ "$no_commit" -eq 0 ]; then
    commit_brewfile remove "$pkg" "$set_name"
  fi
}

# ---------- subcommand: sets ----------

cmd_sets() {
  if [ $# -gt 0 ]; then
    cmd_sets_show "$1"
    return
  fi
  local name file desc count
  {
    printf 'SET\tDESCRIPTION\tENTRIES\n'
    while IFS= read -r name; do
      file="$(brewfile_for_set "$name")"
      desc="$(set_description "$file")"
      count="$(brew bundle list --all --file="$file" | wc -l | tr -d ' ')"
      printf '%s\t%s\t%s\n' "$name" "$desc" "$count"
    done < <(list_set_names)
  } | column -t -s $'\t'
}

cmd_sets_show() {
  local name="$1" file
  file="$(brewfile_for_set "$name")"
  [ -f "$file" ] || { EXIT=2 die "no such set: $name (try 'brewwr sets')"; }

  local section_kind label out
  for section_kind in taps casks formulae; do
    case "$section_kind" in
      taps)     label='TAPS' ;;
      casks)    label='CASKS' ;;
      formulae) label='FORMULAS' ;;
    esac
    out="$(brew bundle list "--$section_kind" --file="$file" || true)"
    [ -n "$out" ] || continue
    printf '%s\n' "$label"
    printf '%s\n' "$out" | sed 's/^/  /'
    printf '\n'
  done
}

# ---------- main ----------

usage() {
  cat <<'EOF'
brewwr — keep install/brew.d/Brewfile.<set> in sync with the host.

Usage:
  brewwr install <pkg> [-s|--set <name>] [--cask|--formula|--tap]
                       [--no-install] [--no-tap-entry] [--no-commit]
  brewwr uninstall <pkg> [--keep-installed] [--no-commit]
  brewwr sets
  brewwr sets <name>

A fully-qualified <pkg> handles its own tap:
  brewwr install drolosoft/tap/crex -s cli
writes both `tap "drolosoft/tap"` and `brew "drolosoft/tap/crex"`.
EOF
}

main() {
  require brew
  require git
  require gum 'brew install gum'
  require jq  'brew install jq'

  DOTFILES_HOME="$(resolve_dotfiles_home)" \
    || { EXIT=1 die 'could not locate dotfiles repo; set DOTFILES_HOME'; }
  export DOTFILES_HOME

  [ $# -gt 0 ] || { usage; exit 0; }
  local sub="$1"; shift
  case "$sub" in
    install)   cmd_install "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    sets)      cmd_sets "$@" ;;
    -h|--help|help) usage ;;
    *) EXIT=2 die "unknown subcommand: $sub" ;;
  esac
}

main "$@"
