#
# Some sane exports. Let's start with XDG
#
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/Library/Application Support}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/Library/Caches}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/Library/Application Support}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/Library/Application Support}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-${TMPDIR}$(id -u)/.run}"
export MISE_DATA_DIR="${MISE_DATA_DIR:-$HOME/.local/share/mise}"
export MISE_STATE_DIR="${MISE_STATE_DIR:-$HOME/.local/state/mise}"

if [[ $COLORTERM = gnome-* && $TERM = xterm ]] && infocmp gnome-256color >/dev/null 2>&1; then
  export TERM=gnome-256color
elif infocmp xterm-256color >/dev/null 2>&1; then
  export TERM=xterm-256color
fi

#
# MacPorts Installer addition on 2011-12-01_at_23:41:50: adding an appropriate PATH variable for use with MacPorts.
#
export PATH="/opt/local/bin:/opt/local/sbin:$PATH"

#
# Make npm then homebrew the priority for all executables before npm
#
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/local/sbin:$HOME/bin:$PATH"

#
# Dotfiles repo root. `brewwr` and similar tools self-locate via git,
# but consumers in the shell (aliases, completions) read this.
#
export DOTFILES_HOME="${DOTFILES_HOME:-$HOME/Git/indexzero/dotfiles}"

#
# Export the local .scripts dir (symlink to $DOTFILES_HOME/scripts)
#
export PATH=$HOME/.scripts:$PATH

#
# Nope. Nope. Nope.
# https://scarf.sh/
#
export SCARF_ANALYTICS=false

#
# React Native development on Android
#
export ANDROID_HOME=~/Library/Android/sdk
export PATH=~/Library/Android/sdk/tools:~/Library/Android/sdk/platform-tools:$PATH

#
# RUBY FOR THE RUBY GODS
#
export PATH="/opt/homebrew/opt/ruby/bin:$PATH"

#
# GO FOR THE GO GODS
#
export PATH="$HOME/go/bin:$PATH"

#
# BUN FOR THE BUN GODS
#
if [ -s "$HOME/.bun/_bun" ]; then
  # _bun calls `compdef _bun bun` at source time; ensure it is defined.
  (( ${+functions[compdef]} )) || { autoload -Uz compinit && compinit -C; }
  source "$HOME/.bun/_bun"
fi
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

#
# Disable telemetry for everything that supports it
# (e.g. claude)
#
export DISABLE_TELEMETRY=1
export DISABLE_ERROR_REPORTING=1
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

#
# Claude bash settings
#
export CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR=1
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/Library/bin:$PATH"

#
# Security hardening
#
source ~/.security

# Turn on for vertx claude
# source ~/.vertx.claude
