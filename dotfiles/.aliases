#
# Some aliases
#
alias nodep='ps axl | grep node'
alias sourcep='source ~/.profile'

# a friendlier delete on the command line
alias emptytrash="find $HOME/.Trash -not -path $HOME/.Trash -exec rm -rf {} \; 2>/dev/null"

# github
alias ghcd=". ghi"
alias cat="ccat"

# git worktree navigation
alias wtr=". wtr"

# bitbucket
alias bh="GIT_REMOTE="bitbucket.org" GIT_ROOT="Bitbucket" . ghi"

# cwd in node. pwd on Linux.
alias cwd="pwd"

# kubernetes
alias k="kubectl"

# git
alias gaa="git add ."
alias gci="git commit"
alias gap="git add -p"
alias gst="git status"
alias gti="git"
alias gita="git pull origin master && git fetch"
alias gitam="git pull origin main && git fetch"

# npm
alias cnit="rm -rf node_modules package-lock.json npm-shrinkwrap.json && npm it"
alias cni="rm -rf node_modules package-lock.json npm-shrinkwrap.json && npm i"
alias cnio="rm -rf node_modules package-lock.json npm-shrinkwrap.json && npm i && npm outdated"
alias cnis="rm -rf node_modules package-lock.json npm-shrinkwrap.json && npm i && npm shrinkwrap"

# lerna
alias lcnp="rm -rf packages/**/{node_modules,package-lock.json,npm-shrinkwrap.json}"
alias lcni="rm -rf node_modules package-lock.json npm-shrinkwrap.json && lcnp && npm i"
alias lcnit="rm -rf node_modules package-lock.json npm-shrinkwrap.json && lcnp && npm it"

# make
alias maek="make"
alias meak="make"
alias meak="make"

# ssh
alias ssht="ssh -f -N -D 9999 -C"

# claude code (nono-sandboxed)
# nono provides kernel-enforced sandbox (macOS Seatbelt / Linux Landlock)
# so --dangerously-skip-permissions is safe: nono is the security boundary
# custom profile: ~/.config/nono/profiles/cc0.json
#   built-in security groups + custom paths:
#   r/w: $CWD, ~/.claude, ~/.npm_local, ~/Experimental, ~/Gist, ~/Git
#   /private/tmp r/w via system_read_macos group
#   git operations: CWD only (advisory, not kernel-enforced)
alias ccd="nono run --allow-cwd --profile cc0 -- claude --dangerously-skip-permissions"
alias ccm="nono run --allow-cwd --profile cc0 -- claude --dangerously-skip-permissions --betas context-1m-2025-08-07"
alias cco="nono run --allow-cwd --profile cc0 -- claude --model claude-opus-4-1-20250805"
alias ccs="nono run --allow-cwd --profile cc0 -- claude --model claude-sonnet-4-5-20250929"
alias ccdo="nono run --allow-cwd --profile cc0 -- claude --dangerously-skip-permissions --model claude-opus-4-1-20250805"
alias ccds="nono run --allow-cwd --profile cc0 -- claude --dangerously-skip-permissions --model claude-sonnet-4-5-20250929"
alias cclogin="nono run --allow-cwd --profile cc0 --allow-launch-services -- claude"
# ccr: rollback mode — nono snapshots cwd before execution, restores on exit
alias ccr="nono run --rollback --profile claude-code -- claude --dangerously-skip-permissions"

# cd aliases for common projects
alias dotf="ghcd indexzero/dotfiles"
alias dotv="ghcd indexzero/dotvibes"
